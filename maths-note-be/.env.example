# Server Configuration
SERVER_URL=0.0.0.0
PORT=8900
ENV=production
SENTRY_DSN=your_sentry_dsn_here

# AI API Keys
GEMINI_API_KEY=your_gemini_api_key_here
# Llama model API via Groq
GROQ_API_KEY=your_groq_api_key_here

# CORS Configuration
ALLOWED_ORIGINS=https://solveiq-two.vercel.app,http://localhost:5173

APP_SECRET=your_app_secret_key_here

# Note: slowapi rate limits are set to 10 requests per minute per IP on public endpoints.

# Gemini Models Configuration (optional overrides)
# GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# GEMINI_MODEL_EXPLAIN=gemini-3.5-flash
