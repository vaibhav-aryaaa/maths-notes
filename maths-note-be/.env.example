# Server Configuration
SERVER_URL=0.0.0.0
PORT=8900
ENV=dev

# Shared API Gateway Secret (must match VITE_APP_KEY in frontend)
APP_SECRET=your_shared_app_secret_key_here

# AI Model Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Database Configuration (PostgreSQL / Supabase; defaults to local SQLite shares.db if omitted)
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres
# DB_PATH=shares.db

# Supabase Auth Verification (for JWKS token decoding)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Optional: explicitly set Supabase project ID (auto-derived from SUPABASE_URL or DATABASE_URL if omitted)
# SUPABASE_PROJECT_ID=your_supabase_project_id_here

# Dev-Only Auth Bypass (active only when ENV=dev)
# DEV_BYPASS_TOKEN=your_dev_bypass_token_here

# CORS Configuration
ALLOWED_ORIGINS=https://solveiq-two.vercel.app,http://localhost:5173

# Monitoring (Optional)
SENTRY_DSN=your_sentry_dsn_here

# Gemini Models Configuration (optional overrides)
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_EXPLAIN=gemini-3.5-flash
